{
  "name": "xcodebug",
  "version": "1.2.2",
  "type": "module",
  "description": "Build, install and launch an iOS app on a physical device and read its console inside the agent session (pi / omp extension)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ios",
    "xcode",
    "xcodebuild",
    "devicectl",
    "ios-device",
    "device-debugging",
    "log-capture",
    "oslog"
  ],
  "author": "codebaby <liuxingsky555@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sublimter/xcodebug.git"
  },
  "homepage": "https://github.com/sublimter/xcodebug#readme",
  "bugs": {
    "url": "https://github.com/sublimter/xcodebug/issues"
  },
  "bin": {
    "xcodebug-setup-codex": "./bin/xcodebug-setup-codex.mjs"
  },
  "files": [
    "*.ts",
    "bin/",
    "mcp/",
    "claude/",
    "README.md",
    "GUIDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
